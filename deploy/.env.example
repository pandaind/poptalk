# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# ── The site that is allowed to call the API (CORS) ───────────────────────────
CORS_ALLOWED_ORIGIN=https://yourwebsite.com
BACKEND_PORT=9097                # published on 127.0.0.1 only; put a TLS proxy in front

# ── Branding ──────────────────────────────────────────────────────────────────
OWNER_NAME=Your Name
CHAT_TITLE=Chat with Me
CHAT_AVATAR_INITIAL=Y
OWNER_WEBSITE_URL=

# ── Telegram (replies in MANUAL mode and visitor notifications) ───────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=
H2_PASSWORD=                     # letters and digits only

# ── Knowledge base (poptalk-rag) ──────────────────────────────────────────────
DB_PASSWORD=
# One key per persona, as personaId:key and comma separated (alice:key1,bob:key2). The same key
# goes in that persona's
# persona.properties as mcp-api-key=, or in MCP_API_KEY below for a single persona.
PERSONA_API_KEYS=default:change-me-to-a-long-random-key
MCP_ENABLED=true
MCP_API_KEY=change-me-to-a-long-random-key
# Pull your site's pages from Meteorite's knowledge.json (see the Meteorite docs):
# KNOWLEDGE_SITE_SOURCES=default=https://yourwebsite.com/knowledge.json

# ── Models ────────────────────────────────────────────────────────────────────
# Local models: start with `docker compose --profile ollama up -d` and keep the defaults.
# Hosted models: set AI_PROVIDER and the matching key, and point embeddings at OpenAI:
AI_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768         # 1536 for OpenAI text-embedding-3-small
RERANK_PROVIDER=ollama           # or openai
# OLLAMA_BASE_URL=http://ollama:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
