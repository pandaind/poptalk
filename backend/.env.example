# ── Branding ──────────────────────────────────────────────────────────────────
# These values appear in the chat widget header and avatar.
# OWNER_NAME can be a person's name or a business/brand name — whichever your
# context.txt speaks as.
OWNER_NAME=Your Name
CHAT_TITLE=Chat with Me
CHAT_AVATAR_INITIAL=Y          # Single letter shown in the avatar bubble
OWNER_WEBSITE_URL=             # Optional — shown in the AI's fallback reply if it can't respond

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=generate_a_long_random_hex_string_here
# Use alphanumeric only — special characters break H2 JDBC parsing
H2_PASSWORD=choose_a_strong_alphanumeric_password

# ── AI Providers ──────────────────────────────────────────────────────────────
# AI_PROVIDER picks which one personas use unless their own persona.properties
# overrides it: ollama, openai, anthropic, mistral, or deepseek.
# Every provider below is wired up regardless of AI_PROVIDER — leave any you're
# not using with a blank API key; they simply won't be available.
AI_PROVIDER=ollama

# Ollama — free, self-hosted, no API key needed for a local install
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=150
OLLAMA_API_KEY=              # Leave empty for local Ollama; set for Ollama Cloud

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_BASE_URL=https://api.openai.com

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TEMPERATURE=0.3
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.3
MISTRAL_BASE_URL=https://api.mistral.ai

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── RAG / Tools via MCP (optional) ──────────────────────────────────────────────
# Point this at a separate MCP server (e.g. a RAG service) speaking Streamable
# HTTP. Leave blank to skip entirely — no connection is attempted and personas
# behave exactly as if this didn't exist.
MCP_RAG_URL=
MCP_RAG_ENDPOINT=/mcp
# Whether personas can use it by default; override per persona with mcp=true
# in its persona.properties.
MCP_ENABLED=false

# ── Runtime ───────────────────────────────────────────────────────────────────
# AI — the configured provider answers | MANUAL — messages forwarded to Telegram admin
CHAT_MODE=AI
CORS_ALLOWED_ORIGIN=https://yourwebsite.com
HOST_PORT=9097               # Host port mapped to container's 8080
